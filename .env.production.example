APP_NAME=KomuniEdad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-komuniedad-host.example
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Use a shared Redis/database cache for persistent throttling on multiple instances.
# A file cache is suitable only for a single persistent server.
CACHE_STORE=file
QUEUE_CONNECTION=sync
KOMUNIEDAD_DEMO=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
