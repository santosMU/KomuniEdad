APP_NAME=KomuniEdad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-komuniedad-host.example
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Use Redis on Vercel so sessions survive across serverless invocations.
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Use a shared Redis/database cache for persistent throttling on multiple instances.
# A file cache is suitable only for a single persistent server.
CACHE_STORE=redis
CACHE_LIMITER=redis
# Configure a reachable shared Redis instance and install the phpredis extension.
# Use DB 0 for providers that support only one logical database.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_DB=0
REDIS_CACHE_DB=0
QUEUE_CONNECTION=sync
KOMUNIEDAD_DEMO=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
